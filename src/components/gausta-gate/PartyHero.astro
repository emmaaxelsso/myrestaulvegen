---
import { Image } from 'astro:assets';
import gaustaImage from '../../assets/images/gausta-hero.jpg';
---

<section class="party-hero" aria-labelledby="party-title">
  <Image
    src={gaustaImage}
    alt="Utsikt över Gaustatoppen"
    class="party-image"
    widths={[640, 1024, 1600, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <div class="container hero-copy">
    <p class="eyebrow">Willi fyller 28</p>

    <h1 id="party-title">
      Gausta Gate <span>2027</span>
    </h1>

    <p class="hero-description">
      En långhelg med vänner, fjälluft och födelsedagsfirande.
      Här hittar ni helgens planer och allt inför resan.
    </p>

    <ul class="hero-details" aria-label="Datum och plats">
      <li>4–7 februari 2027</li>
      <li>Myrestaulvegen 83 · Gausta</li>
    </ul>

    <div class="hero-actions">
      <a class="button" href="#helgen">
        Se helgens schema <span aria-hidden="true">↓</span>
      </a>

      <a class="hero-secondary" href="#praktiskt">
        Inför helgen
      </a>
    </div>
  </div>
</section>