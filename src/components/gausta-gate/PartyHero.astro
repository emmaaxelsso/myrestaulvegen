---
import { Image } from 'astro:assets';
import gaustaImage from '../../assets/images/gausta-hero.jpg';
---

<section class="party-hero" aria-labelledby="party-title">
    <Image
      src={gaustaImage}
      alt="Gaustatoppen i kvällsljus"
      class="party-image"
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />

    <div class="container hero-copy">
      <p class="eyebrow">Gausta, Norge · 4–7 februari 2027</p>

      <h1 id="party-title">
        GAUSTA<br />
        GATE <em>2027</em>
      </h1>

      <p class="birthday">
        Willi fyller 28. Vi tar det till fjällen.
      </p>

      <p class="intro">
        Ett hus, ett gäng kompisar och en långhelg att fira
        tillsammans. Varmt välkomna till födelsedagshelgen i Gausta!
      </p>

      <a class="button" href="#helgen">
        Se helgens schema
        <span aria-hidden="true">↓</span>
      </a>
    </div>

    <span class="stamp" aria-hidden="true">
      28
      <small>år att fira</small>
    </span>
  </section>