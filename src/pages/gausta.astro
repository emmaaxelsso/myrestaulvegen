---
import Layout from '../layouts/Layout.astro';
import { activityCategories } from '../data/activities.js';
---

<Layout title="Upptäck Gausta | Myrestaulvegen 83">
  <div class="gausta-page container">
    <header class="page-heading">
      <p class="eyebrow">Upptäck Gausta</p>
      <h1>Ut på små och stora äventyr.</h1>
      <p class="introduction">
        En dag på skidor, en promenad på fjället eller något gott
        att äta. Här samlar vi tips för dagarna här.
      </p>
    </header>

    <nav class="category-nav" aria-label="Hitta bland tipsen">
      {activityCategories.map(({ id, title }) => (
        <a href={`#${id}`}>{title}</a>
      ))}
    </nav>

    {activityCategories.map(({ id, title, description, activities }) => (
      <section
        class="activity-section"
        id={id}
        aria-labelledby={`${id}-title`}
      >
        <h2 id={`${id}-title`}>{title}</h2>
        <p class="section-description">{description}</p>

        <div class="activity-grid">
          {activities.map((activity) => (
            <article class="activity-card" id={activity.id}>
              <h3>{activity.title}</h3>
              <p>{activity.description}</p>

              {activity.link && (
                <a class="activity-link" href={activity.link.href}>
                  {activity.link.label}
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

<style>
  .gausta-page {
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .page-heading {
    max-width: 45rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 400;
  }

  .introduction {
    margin: 1.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .category-nav a {
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 2rem;
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .category-nav a:hover {
    background: var(--color-stone);
    border-color: var(--color-primary);
  }

  .activity-section {
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 2rem;
  }

  .activity-section + .activity-section {
    margin-top: 3rem;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 400;
  }

  .section-description {
    margin: 0.75rem 0 1.75rem;
    color: var(--color-text-muted);
  }

  .activity-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .activity-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    scroll-margin-top: 2rem;
  }

  h3 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 400;
  }

  .activity-card p {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
  }

  .activity-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 45rem) {
    .activity-grid {
      grid-template-columns: 1fr;
    }
  }
</style>